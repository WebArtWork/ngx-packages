{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"cli": {
		"analytics": false
	},
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"ngx-datetime-app": {
			"projectType": "application",
			"root": "projects/ngx-datetime-app",
			"sourceRoot": "projects/ngx-datetime-app/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "projects/ngx-datetime-app/src/main.ts",
						"server": "projects/ngx-datetime-app/src/main.server.ts",
						"index": "projects/ngx-datetime-app/src/index.html",
						"tsConfig": "projects/ngx-datetime-app/tsconfig.app.json",
						"prerender": {
							"discoverRoutes": true,
							"routesFile": "projects/ngx-datetime-app/src/prerender-routes.txt"
						},
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/ngx-datetime-app/src/assets"
							}
						],
						"styles": ["projects/ngx-datetime-app/src/styles.scss"]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "8kB",
									"maximumError": "12kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "ngx-datetime-app:build:production"
						},
						"development": {
							"buildTarget": "ngx-datetime-app:build:development"
						}
					},
					"defaultConfiguration": "development"
				}
			}
		},
